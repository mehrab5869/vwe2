# Multi-stage build for production
FROM node:18-alpine AS frontend-builder

# Build Admin UI
WORKDIR /app/admin-ui
COPY admin-ui/package*.json ./
RUN npm install
COPY admin-ui/ .
RUN npm run build

# Build User Dashboard
WORKDIR /app/user-dashboard
COPY user-dashboard/package*.json ./
RUN npm install
COPY user-dashboard/ .
RUN npm run build

# Production stage
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend code
COPY backend/ .
COPY app/ ./app/

# Copy frontend builds to app directory
COPY --from=frontend-builder /app/admin-ui/build ./static/admin
COPY --from=frontend-builder /app/user-dashboard/build ./static/user

# Create non-root user
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

# Expose port
EXPOSE 8000

# Set PYTHONPATH
ENV PYTHONPATH=/app

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Start command
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]