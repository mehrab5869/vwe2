# Dockerfile.simple (fixed for Koyeb single-service deploy)
FROM python:3.11-slim

# Workdir inside container
WORKDIR /app

# Minimal system deps (remove heavy toolchain)
RUN apt-get update && apt-get install -y --no-install-recommends libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install backend dependencies (use backend/requirements.txt)
COPY backend/requirements.txt /app/requirements.txt
RUN pip install --upgrade pip && pip install --no-cache-dir -r /app/requirements.txt

# Copy ONLY backend source so /app/main.py exists
COPY backend/ /app/

# Expose default port; platform will set $PORT
EXPOSE 8000

# Healthcheck respecting $PORT (fallback 8000)
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD python -c "import os, urllib.request; p=os.environ.get('PORT','8000'); urllib.request.urlopen('http://localhost:'+p+'/health')" || exit 1

# Run uvicorn using $PORT if provided by platform
CMD ["bash", "-lc", "uvicorn main:app --host 0.0.0.0 --port ${PORT:-8000}"]
