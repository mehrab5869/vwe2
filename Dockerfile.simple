# Dockerfile.simple — minimal, robust entrypoint
FROM python:3.11-slim

WORKDIR /app

# system deps for building and postgres support
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
    gcc build-essential libpq-dev curl \
 && rm -rf /var/lib/apt/lists/*

# copy deps first for cache-friendly builds
COPY requirements.txt /app/requirements.txt

RUN pip install --upgrade pip \
 && pip install -r /app/requirements.txt

# copy project
COPY . /app

# copy backend files to maintain structure
COPY backend /app/backend

# Ensure backend is also accessible from root
RUN ln -sf /app/backend/main.py /app/main.py || true

# ensure python can import from /app
ENV PYTHONPATH=/app:/app/backend

EXPOSE 8000

# healthcheck using python stdlib (no curl required)
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD python -c "import urllib.request,sys; urllib.request.urlopen('http://localhost:8000/health'); sys.exit(0)" || exit 1

# copy start helper and make executable
COPY start.py /app/start.py
RUN chmod +x /app/start.py

# run the app directly since we know main:app works
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--loop", "uvloop", "--workers", "1"]
