# Dockerfile.simple — replace existing Dockerfile.simple
FROM python:3.11-slim

WORKDIR /app

# system deps for building wheels and postgres client libs
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
    gcc build-essential libpq-dev curl \
 && rm -rf /var/lib/apt/lists/*

# copy deps first for docker cache
COPY requirements.txt /app/requirements.txt

RUN pip install --upgrade pip \
 && pip install -r /app/requirements.txt

# copy project
COPY . /app

# make sure python can import packages from /app
ENV PYTHONPATH=/app

EXPOSE 8000

# healthcheck: use python stdlib to avoid curl dependency
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD python -c "import urllib.request,sys; urllib.request.urlopen('http://localhost:8000/health'); sys.exit(0)" || exit 1

# try app at app.main:app first (common), fallback to main:app
CMD ["bash", "-lc", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} || uvicorn main:app --host 0.0.0.0 --port ${PORT:-8000}"]
