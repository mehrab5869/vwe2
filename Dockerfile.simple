# Dockerfile.simple — minimal, robust entrypoint
FROM python:3.11-slim

WORKDIR /app

# system deps for building and postgres support
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
    gcc build-essential libpq-dev curl \
 && rm -rf /var/lib/apt/lists/*

# copy deps first for cache-friendly builds
COPY requirements.txt /app/requirements.txt

RUN pip install --upgrade pip \
 && pip install -r /app/requirements.txt

# copy project
COPY . /app

# ensure python can import from /app
ENV PYTHONPATH=/app:/app/backend

EXPOSE 8000

# healthcheck using python stdlib (no curl required)
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD python -c "import urllib.request,sys; urllib.request.urlopen('http://localhost:8000/health'); sys.exit(0)" || exit 1

# copy start helper and make executable
COPY start.py /app/start.py
RUN chmod +x /app/start.py

# run the startup helper (it auto-detects the correct module and runs uvicorn)
CMD ["bash", "-lc", "python /app/start.py"]
