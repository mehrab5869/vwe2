{
  "version": "1.0",
  "services": {
    "backend": {
      "type": "python",
      "buildCommand": "pip install -r backend/requirements.txt",
      "startCommand": "cd backend && PYTHONPATH=. uvicorn main:app --host 0.0.0.0 --port $PORT",
      "env": {
        "PYTHONPATH": "."
      }
    }
  }
}